<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:layoutDirection="rtl" android:padding="16dp" android:gravity="top">
    <TextClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:fontFamily="@font/tajawal_extrabold" android:includeFontPadding="false"
        android:textColor="@color/text" android:textSize="40sp" />
    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/nextLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/gold" android:fontFamily="@font/tajawal_bold"
        android:textSize="13sp" android:maxLines="1" android:layout_marginTop="4dp" />
    <Chronometer android:id="@+id/nextChrono" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text" android:fontFamily="@font/tajawal_extrabold"
        android:includeFontPadding="false" android:textSize="30sp" />
    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" android:max="1000" android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="0dp">
            <TextView android:id="@+id/curLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/curChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_bold"
                android:textSize="15sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
            <TextView android:id="@+id/iqLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/iqChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_bold"
                android:textSize="15sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
            <TextView android:id="@+id/prevLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/prevChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_medium"
                android:textSize="15sp" android:includeFontPadding="false" />
        </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" android:background="#1AFFFFFF" />
    <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n0" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t3" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n4" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t4" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/n5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
        <TextView android:id="@+id/t5" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
