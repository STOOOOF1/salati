<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:layoutDirection="rtl" android:padding="12dp" android:gravity="center_vertical">
    <TextClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:fontFamily="@font/tajawal_extrabold" android:includeFontPadding="false"
        android:textColor="@color/text" android:textSize="16sp" />
    <TextView android:id="@+id/nextLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/gold" android:fontFamily="@font/tajawal_bold"
        android:textSize="12sp" android:maxLines="1" android:layout_marginTop="4dp" />
    <Chronometer android:id="@+id/nextChrono" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text" android:fontFamily="@font/tajawal_extrabold"
        android:includeFontPadding="false" android:textSize="26sp" />
    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" android:max="1000" android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="0dp">
            <TextView android:id="@+id/curLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/curChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_bold"
                android:textSize="12sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
            <TextView android:id="@+id/iqLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/iqChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_bold"
                android:textSize="12sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
            <TextView android:id="@+id/prevLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted" android:fontFamily="@font/tajawal_medium"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/prevChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/tajawal_medium"
                android:textSize="12sp" android:includeFontPadding="false" />
        </LinearLayout>
</LinearLayout>
