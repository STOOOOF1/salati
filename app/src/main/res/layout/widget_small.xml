<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:layoutDirection="rtl" android:padding="10dp" android:gravity="center_vertical">
    <TextClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:format12Hour="h:mm a" android:format24Hour="HH:mm"
        android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/strip" android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@color/accent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/curLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/curChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/nextLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/nextChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/prevLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/prevChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="13sp"  />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/iqLabel" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/muted"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/iqChrono" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="13sp"  />
        </LinearLayout>
</LinearLayout>
